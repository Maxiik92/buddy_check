{* _userForm.latte *}
<div class="col-md-6">
    <label class="form-label" n:name="username">{_"username"|firstUpper}</label>
    <input n:name="username" id="username" class="form-control" data-field="username">
    <div id="username-error" class="invalid-feedback error n:ifcontent">
        {inputError username}
    </div>
</div>

<div class="col-md-6">
    <label class="form-label" n:name="email">{_"email"|firstUpper}</label>
    <input n:name="email" id="email" class="form-control" data-field="email">
    <div id="email-error" class="invalid-feedback error n:ifcontent">
        {inputError email}
    </div>
</div>

<div class="col-md-4">
    <label class="form-label" n:name="first_name">{_"firstname"|firstUpper}</label>
    <input n:name="first_name" id="first_name" class="form-control">
    <div class="invalid-feedback error n:ifcontent">
        {inputError first_name}
    </div>
</div>

<div class="col-md-4">
    <label class="form-label" n:name="middle_name">{_"middlename"|firstUpper}</label>
    <input n:name="middle_name" id="middle_name" class="form-control">
    <div class="invalid-feedback error n:ifcontent">
        {inputError middle_name}
    </div>
</div>

<div class="col-md-4">
    <label class="form-label" n:name="last_name">{_"lastname"|firstUpper}</label>
    <input n:name="last_name" id="last_name" class="form-control">
    <div class="invalid-feedback error n:ifcontent">
        {inputError last_name}
    </div>
</div>

<div class="col-md-6">
    <label class="form-label" n:name="password" data-toggle="tooltip" data-placement="top" title="{$passwordRequirements}">
      {_"password"|firstUpper}
      <i class="fa-solid fa-circle-info"></i>
    </label>
    <div class='pass-input'>
      <input n:name="password" id="password" class="form-control">
      <i class="far fa-eye-slash togglePassword"></i>
    </div>
    <div class="invalid-feedback error n:ifcontent">
        {inputError password}
    </div>
</div>

<div class="col-md-6">
    <label class="form-label" n:name="passwordConfirm">{_"confirm"|firstUpper} {_"password"|firstUpper}</label>
    <div class='pass-input'>
      <input n:name="passwordConfirm" id="passwordConfirm" class="form-control">
      <i class="far fa-eye-slash togglePassword"></i>
    </div>
    <div class="invalid-feedback error n:ifcontent">
        {inputError passwordConfirm}
    </div>
</div>

<button type="submit" class="col-md-4 btn btn-primary">
    {if !$presenter->isLinkCurrent(':User:register:default')}
        {_"save"|firstUpper}
    {else}
        {_"signup"|firstUpper}
    {/if}
</button>